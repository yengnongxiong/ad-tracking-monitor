# Copy to .env (`make dev` does this for you on first run). Never commit .env.

# --- Host ports -----------------------------------------------------------------
# Off the usual 5432/8000/3000 so the stack can run next to other local projects.
POSTGRES_PORT=5433
API_PORT=8001
WEB_PORT=3001
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
DEMO_SITE_PORT=8088

# --- Postgres -------------------------------------------------------------------
POSTGRES_USER=tagmonitor
POSTGRES_PASSWORD=tagmonitor
POSTGRES_DB=tagmonitor
# For code run on your host (tests, CLIs). Containers get a compose-internal URL instead.
DATABASE_URL=postgresql://tagmonitor:tagmonitor@localhost:5433/tagmonitor

# --- MinIO (local S3) -----------------------------------------------------------
MINIO_ROOT_USER=tagmonitor
MINIO_ROOT_PASSWORD=tagmonitor-dev-secret
# For code run on your host. Containers get compose-internal values instead.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=tagmonitor
S3_SECRET_KEY=tagmonitor-dev-secret
S3_BUCKET=tagmonitor

# --- App ------------------------------------------------------------------------
LOG_LEVEL=INFO
# Capture slots per worker process; `make dev` runs two worker containers.
WORKER_CONCURRENCY=3
# A daily job deletes monitoring history (runs, results, captures) older than this.
RETENTION_DAYS=90
# Mobile throttling for captures: none | slow4g
CAPTURE_THROTTLING=none

# --- Alerts -------------------------------------------------------------------------
# console | smtp | resend. Containers use smtp -> Mailpit (see docker-compose.yml).
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=tag-monitor <alerts@tagmonitor.local>
# RESEND_API_KEY=re_...   (only for EMAIL_BACKEND=resend)
# Wait between a first failure and its confirmation re-check. The product default is
# 600 (10 minutes); 60 keeps the local demo snappy.
CONFIRM_DELAY_SECONDS=60
# "Check now" cooldown per site. The product default is 300; 20 suits the local demo.
CHECK_NOW_COOLDOWN_SECONDS=20
APP_BASE_URL=http://localhost:3001

# --- LLM message match ----------------------------------------------------------------
# Leave empty to turn the check off (sites with ad copy then show "turned off").
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# The prompt monitoring uses: evals/message_match/prompts/<version>.md
LLM_PROMPT_VERSION=v1
# Every model call counts (monitoring and evals); cache hits don't.
LLM_MAX_CALLS_PER_DAY=500
# The check forces a tool call to get structured output, and sends temperature 0. Claude
# Haiku 4.5 accepts both. Newer models reject a temperature (set this to an empty value to
# not send one), and Claude Opus 5.5, Sonnet 5.5 and Fable 5.1 also reject a forced tool
# call, so they'd need a code change before LLM_MODEL can point at them.
LLM_TEMPERATURE=0
